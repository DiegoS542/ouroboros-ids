# Ouroboros IDS — Plantilla de configuración
# Copia este archivo como .env y llena los valores reales:
#   cp .env.example .env

# ── Correo ──────────────────────────────────────────────────────────────────
# Cuenta desde la que se envían las alertas (Gmail recomendado)
SMTP_EMAIL=tu_correo@gmail.com

# App Password de Gmail (no la contraseña normal de tu cuenta)
# Genérala en: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Servidor y puerto SMTP (valores por defecto para Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Correo del administrador que recibe las alertas
ADMIN_EMAIL=admin@ejemplo.com

# ── APIs externas ────────────────────────────────────────────────────────────
# API key de AbuseIPDB para análisis forense de IPs peligrosas
# Regístrate en: https://www.abuseipdb.com/register
ABUSEIPDB_KEY=tu_api_key_aqui

# ── Base de datos ────────────────────────────────────────────────────────────
# Ruta al archivo SQLite (relativa a la raíz del proyecto)
DB_PATH=data/ouroboros.db
